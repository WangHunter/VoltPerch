<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>VoltPerch</AssemblyName>
    <RootNamespace>BatteryDesk</RootNamespace>
    <Version>0.2.0</Version>
    <Product>VoltPerch</Product>
    <Title>VoltPerch</Title>
    <Description>A lightweight Windows peripheral battery monitor.</Description>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <EmbeddedResource Include="Localization\*.json" WithCulture="false" />
  </ItemGroup>
</Project>
