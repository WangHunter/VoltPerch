<Window x:Class="BatteryDesk.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BatteryDesk" Title="VoltPerch" Icon="/Assets/app.ico" Width="960" Height="650" MinWidth="640" MinHeight="460" WindowStartupLocation="CenterScreen" Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="UiStyles.xaml"/></ResourceDictionary.MergedDictionaries>
      <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
          <Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="DeviceScrollerStyle" TargetType="ScrollViewer">
        <Style.Resources>
          <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Margin" Value="0,4,3,5"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                  <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
                    <Track.Thumb>
                      <Thumb>
                        <Thumb.Template>
                          <ControlTemplate TargetType="Thumb">
                            <Border Background="Transparent">
                              <Border x:Name="Grip" Width="6" Background="{DynamicResource MutedBrush}" CornerRadius="3" Opacity="0.48"/>
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Opacity" Value="0.8"/></Trigger>
                              <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Opacity" Value="1"/></Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Thumb.Template>
                      </Thumb>
                    </Track.Thumb>
                  </Track>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Style.Resources>
      </Style>
      <Style x:Key="DeviceFilter" TargetType="RadioButton">
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Border x:Name="FilterFrame" Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                <ContentPresenter RecognizesAccessKey="True"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FilterFrame" Property="Background" Value="{DynamicResource TileBrush}"/></Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="FilterFrame" Property="Background" Value="{DynamicResource TileBrush}"/>
                  <Setter TargetName="FilterFrame" Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                  <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                  <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FilterFrame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid x:Name="Viewport" Margin="26,22,26,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0">
        <TextBlock x:Name="PageTitle" Text="{DynamicResource Loc.MainTitle}" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock x:Name="PageSubtitle" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap"/>
      </StackPanel>
      <Grid Grid.Column="1" VerticalAlignment="Center">
        <Button x:Name="BackButton" Style="{StaticResource ToolbarButton}" Click="BackClick" Visibility="Collapsed" ToolTip="{DynamicResource Loc.BackToDevicesHint}" AutomationProperties.Name="{DynamicResource Loc.BackToDevices}">
          <StackPanel Orientation="Horizontal"><local:ToolbarIcon Kind="Back"/><TextBlock Text="{DynamicResource Loc.BackToDevices}" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
        </Button>
        <StackPanel x:Name="DeviceToolbar" Orientation="Horizontal">
          <Button x:Name="RefreshButton" Style="{StaticResource ToolbarButton}" Click="RefreshClick" ToolTip="{DynamicResource Loc.RefreshHint}" AutomationProperties.Name="{DynamicResource Loc.RefreshDevices}" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal"><local:ToolbarIcon Kind="Refresh"/><TextBlock x:Name="RefreshLabel" Text="{DynamicResource Loc.Refresh}" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
          </Button>
          <Button Style="{StaticResource ToolbarButton}" Click="ThemeClick" ToolTip="{DynamicResource Loc.ToggleThemeHint}" AutomationProperties.Name="{DynamicResource Loc.ToggleTheme}" Width="40" Padding="0" Margin="0,0,8,0"><local:ToolbarIcon Kind="Theme"/></Button>
          <Button Style="{StaticResource ToolbarButton}" Click="SettingsClick" ToolTip="{DynamicResource Loc.Settings}" AutomationProperties.Name="{DynamicResource Loc.OpenSettings}" Width="40" Padding="0"><local:ToolbarIcon Kind="Settings"/></Button>
        </StackPanel>
      </Grid>
    </Grid>
    <Grid Grid.Row="1" x:Name="DevicesLayout">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailColumn" Width="0"/></Grid.ColumnDefinitions>
      <Border x:Name="DeviceListFrame" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="AllFilter" Style="{StaticResource DeviceFilter}" GroupName="DeviceFilters" Content="{DynamicResource Loc.AllDevices}" Checked="FilterChecked" Tag="All" IsChecked="True"/>
              <RadioButton x:Name="ConnectedFilter" Style="{StaticResource DeviceFilter}" GroupName="DeviceFilters" Content="{DynamicResource Loc.Connected}" Checked="FilterChecked" Tag="Connected" Margin="4,0"/>
              <RadioButton x:Name="OfflineFilter" Style="{StaticResource DeviceFilter}" GroupName="DeviceFilters" Content="{DynamicResource Loc.Disconnected}" Checked="FilterChecked" Tag="Disconnected"/>
            </StackPanel>
          </Border>
          <ScrollViewer x:Name="DeviceScroller" Grid.Row="1" Padding="8" Style="{StaticResource DeviceScrollerStyle}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="DeviceRows"/></ScrollViewer>
          <StackPanel x:Name="EmptyPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Margin="24" IsHitTestVisible="False">
            <TextBlock x:Name="EmptyTitle" Text="{DynamicResource Loc.NoDevices}" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock x:Name="EmptyText" Margin="0,8,0,0" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border x:Name="DetailFrame" Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Visibility="Collapsed">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,8">
            <DockPanel>
              <Button x:Name="CloseDetailButton" DockPanel.Dock="Right" Content="×" Width="34" Height="34" Padding="0" FontSize="21" Click="CloseDetailsClick" AutomationProperties.Name="{DynamicResource Loc.CloseDetails}" ToolTip="{DynamicResource Loc.CloseDetails}"/>
              <TextBlock Text="{DynamicResource Loc.DeviceDetails}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
          <ScrollViewer x:Name="DetailScroller" Grid.Row="1" Padding="16,14,16,16" Style="{StaticResource DeviceScrollerStyle}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="DetailsContent" MaxWidth="560"/>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
    <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" Visibility="Collapsed"><WrapPanel x:Name="SettingsContent"/></ScrollViewer>
    <TextBlock x:Name="StatusLabel" Grid.Row="2" Margin="0,12,0,0" Text="{DynamicResource Loc.FindingDevices}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
  </Grid>
</Window>
