<Window x:Class="BatteryDesk.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BatteryDesk" Title="VoltPerch" Icon="/Assets/app.ico" Width="900" Height="620" MinWidth="640" MinHeight="460" WindowStartupLocation="CenterScreen" Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="UiStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Grid x:Name="Viewport">
  <Grid x:Name="ScaleHost">
  <Grid Margin="30,24,30,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <StackPanel><TextBlock x:Name="PageTitle" Text="{DynamicResource Loc.MainTitle}" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="{DynamicResource Loc.MainSubtitle}" FontSize="14" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="BackButton" Style="{StaticResource ToolbarButton}" Click="BackClick" Visibility="Collapsed" ToolTip="{DynamicResource Loc.BackToDevicesHint}" AutomationProperties.Name="{DynamicResource Loc.BackToDevices}">
          <StackPanel Orientation="Horizontal"><local:ToolbarIcon Kind="Back"/><TextBlock Text="{DynamicResource Loc.BackToDevices}" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
        </Button>
        <StackPanel x:Name="DeviceToolbar" Orientation="Horizontal">
          <Button x:Name="RefreshButton" Style="{StaticResource ToolbarButton}" Click="RefreshClick" ToolTip="{DynamicResource Loc.RefreshHint}" AutomationProperties.Name="{DynamicResource Loc.RefreshDevices}" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal"><local:ToolbarIcon Kind="Refresh"/><TextBlock x:Name="RefreshLabel" Text="{DynamicResource Loc.Refresh}" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
          </Button>
          <Button Style="{StaticResource ToolbarButton}" Click="ThemeClick" ToolTip="{DynamicResource Loc.ToggleThemeHint}" AutomationProperties.Name="{DynamicResource Loc.ToggleTheme}" Width="40" Padding="0" Margin="0,0,8,0"><local:ToolbarIcon Kind="Theme"/></Button>
          <Button Style="{StaticResource ToolbarButton}" Click="SettingsClick" ToolTip="{DynamicResource Loc.Settings}" AutomationProperties.Name="{DynamicResource Loc.OpenSettings}" Width="40" Padding="0"><local:ToolbarIcon Kind="Settings"/></Button>
        </StackPanel>
      </StackPanel>
    </Grid>
    <Grid x:Name="FilterBar" Grid.Row="1" Margin="0,24,0,18">
      <Border Background="{DynamicResource TileBrush}" CornerRadius="20" Padding="4" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><Button x:Name="AllFilter" Content="{DynamicResource Loc.AllDevices}" Click="FilterClick" Tag="All" BorderThickness="0" Padding="18,7"/><Button x:Name="ConnectedFilter" Content="{DynamicResource Loc.Connected}" Click="FilterClick" Tag="Connected" BorderThickness="0" Padding="18,7" Margin="3,0"/><Button x:Name="OfflineFilter" Content="{DynamicResource Loc.Disconnected}" Click="FilterClick" Tag="Disconnected" BorderThickness="0" Padding="18,7"/></StackPanel></Border>
      <TextBlock x:Name="CountLabel" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/>
    </Grid>
    <Grid Grid.Row="2" x:Name="DevicesLayout">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailColumn" Width="0"/></Grid.ColumnDefinitions>
      <Border x:Name="DeviceListFrame" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="18">
        <Grid><ScrollViewer Padding="8,5"><StackPanel x:Name="DeviceRows"/></ScrollViewer><StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="390" Margin="24"><TextBlock Text="{DynamicResource Loc.NoDevices}" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyText" Text="{DynamicResource Loc.ConnectDeviceHint}" Margin="0,12,0,0" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></Grid>
      </Border>
      <Border x:Name="DetailFrame" Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="18" Margin="18,0,0,0" Visibility="Collapsed">
        <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="{DynamicResource Loc.DeviceDetails}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="×" HorizontalAlignment="Right" Width="32" Height="32" Padding="0" Click="CloseDetailsClick" AutomationProperties.Name="{DynamicResource Loc.CloseDetails}" BorderThickness="0"/></Grid><ScrollViewer Grid.Row="1" Margin="0,18,0,0"><StackPanel x:Name="DetailsContent"/></ScrollViewer></Grid>
      </Border>
    </Grid>
    <ScrollViewer x:Name="SettingsScroll" Grid.Row="2" Visibility="Collapsed" Margin="0,24,0,0"><WrapPanel x:Name="SettingsContent"/></ScrollViewer>
    <Grid Grid.Row="3" Margin="4,16,4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusLabel" Text="{DynamicResource Loc.FindingDevices}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{DynamicResource Loc.LastBatteryRetained}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="16,0,0,0"/></Grid>
  </Grid>
  </Grid>
  </Grid>
</Window>
