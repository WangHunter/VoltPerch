<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/BatteryDesk/Localizer.cs" Link="Localizer.cs" />
    <EmbeddedResource Include="../../src/BatteryDesk/Localization/*.json" WithCulture="false">
      <LogicalName>BatteryDesk.Localization.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
